plt.figure(figsize=(10, 4))
plt.plot(df['Date'], df['Steps'], marker='o', label='Steps')
plt.axhline(STEP_GOAL, linestyle='--', label='Step Goal')
plt.title('Daily Steps')
plt.xlabel('Date')
plt.ylabel('Number of Steps')
plt.xticks(rotation=45)
plt.legend()
plt.tight_layout()
plt.show()

plt.figure(figsize=(10, 4))
plt.bar(df['Date'].dt.strftime('%a'), df['Workout_Minutes'])
plt.title('Daily Workout Duration')
plt.xlabel('Day')
plt.ylabel('Minutes')
plt.tight_layout()
plt.show()

plt.figure(figsize=(10, 4))
plt.plot(df['Date'], df['Water_Liters'], marker='o', label='Water (L)')
plt.plot(df['Date'], df['Sleep_Hours'], marker='s', label='Sleep (hours)')
plt.title('Water Intake and Sleep')
plt.xlabel('Date')
plt.xticks(rotation=45)
plt.legend()
plt.tight_layout()
plt.show()
